{
  "name": "@cikada/test-harness",
  "version": "0.1.0",
  "description": "Standalone test harness for validating reactive agents without full server stack",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@cikada/agent": "workspace:*",
    "@cikada/local-runtime": "workspace:*",
    "ulid": "^2.3.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "zod": "^3.24.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
