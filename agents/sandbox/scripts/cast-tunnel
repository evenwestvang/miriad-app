#!/bin/bash
# cast-tunnel - CLI wrapper for rathole tunnel client
# Manages HTTP tunnel connection for CAST agent containers

set -e

# Configuration from environment
TUNNEL_SERVER_URL="${TUNNEL_SERVER_URL:-}"
TUNNEL_HASH="${TUNNEL_HASH:-}"
TUNNEL_LOCAL_PORT="${TUNNEL_LOCAL_PORT:-8080}"
CAST_AUTH_TOKEN="${CAST_AUTH_TOKEN:-}"

# Runtime state (populated after registration)
TUNNEL_CONFIG_DIR="${TUNNEL_CONFIG_DIR:-/tmp/tunnel}"
TUNNEL_PID_FILE="${TUNNEL_CONFIG_DIR}/rathole.pid"
TUNNEL_CONFIG_FILE="${TUNNEL_CONFIG_DIR}/client.toml"
TUNNEL_REG_FILE="${TUNNEL_CONFIG_DIR}/registration.json"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[tunnel]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[tunnel]${NC} $1"
}

log_error() {
    echo -e "${RED}[tunnel]${NC} $1" >&2
}

# Register with tunnel server and get credentials
register_with_server() {
    if [ -z "$TUNNEL_SERVER_URL" ]; then
        log_error "TUNNEL_SERVER_URL not set"
        return 1
    fi
    if [ -z "$TUNNEL_HASH" ]; then
        log_error "TUNNEL_HASH not set"
        return 1
    fi
    if [ -z "$CAST_AUTH_TOKEN" ]; then
        log_error "CAST_AUTH_TOKEN not set"
        return 1
    fi

    mkdir -p "$TUNNEL_CONFIG_DIR"

    log_info "Registering with tunnel server..."

    # Extract base URL (remove port if present for HTTPS registration)
    local base_url
    if [[ "$TUNNEL_SERVER_URL" == https://* ]]; then
        base_url="$TUNNEL_SERVER_URL"
    else
        # Assume HTTPS if no protocol specified
        base_url="https://${TUNNEL_SERVER_URL%%:*}"
    fi

    # Call registration endpoint
    local response
    response=$(curl -s -w "\n%{http_code}" \
        -X POST "${base_url}/clients/register" \
        -H "Authorization: Container ${CAST_AUTH_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "{\"tunnelHash\": \"${TUNNEL_HASH}\"}" \
        2>&1)

    local http_code
    http_code=$(echo "$response" | tail -n1)
    local body
    body=$(echo "$response" | sed '$d')

    if [ "$http_code" != "200" ] && [ "$http_code" != "201" ]; then
        log_error "Registration failed (HTTP $http_code): $body"
        return 1
    fi

    # Save registration response
    echo "$body" > "$TUNNEL_REG_FILE"

    # Extract fields from JSON response
    local service_token control_port service_name
    service_token=$(echo "$body" | jq -r '.serviceToken // empty')
    control_port=$(echo "$body" | jq -r '.controlPort // 2333')
    service_name=$(echo "$body" | jq -r '.serviceName // empty')

    if [ -z "$service_token" ]; then
        log_error "Registration response missing serviceToken"
        return 1
    fi

    log_info "Registered successfully (service: ${service_name:-$TUNNEL_HASH})"

    # Export for config generation
    export REGISTERED_TOKEN="$service_token"
    export REGISTERED_CONTROL_PORT="$control_port"
    export REGISTERED_SERVICE_NAME="${service_name:-$TUNNEL_HASH}"
}

# Generate rathole client config from registration response
generate_config() {
    if [ -z "$REGISTERED_TOKEN" ]; then
        log_error "Not registered - run register_with_server first"
        return 1
    fi

    # Extract host from TUNNEL_SERVER_URL
    local server_host
    server_host=$(echo "$TUNNEL_SERVER_URL" | sed -E 's|^https?://||' | sed -E 's|:[0-9]+$||' | sed -E 's|/.*$||')

    mkdir -p "$TUNNEL_CONFIG_DIR"

    cat > "$TUNNEL_CONFIG_FILE" << EOF
# Auto-generated rathole client config
# Generated by cast-tunnel after registration

[client]
remote_addr = "${server_host}:${REGISTERED_CONTROL_PORT}"
heartbeat_timeout = 40
retry_interval = 1

[client.services.${REGISTERED_SERVICE_NAME}]
token = "${REGISTERED_TOKEN}"
local_addr = "127.0.0.1:${TUNNEL_LOCAL_PORT}"
EOF

    log_info "Config generated at $TUNNEL_CONFIG_FILE"
}

# Start tunnel connection
cmd_up() {
    if is_running; then
        log_warn "Tunnel already running (PID: $(cat "$TUNNEL_PID_FILE"))"
        return 0
    fi

    log_info "Starting tunnel..."

    # Step 1: Register with tunnel server to get credentials
    register_with_server || return 1

    # Step 2: Generate rathole config with received credentials
    generate_config || return 1

    # Start rathole in background
    nohup rathole --client "$TUNNEL_CONFIG_FILE" > "${TUNNEL_CONFIG_DIR}/rathole.log" 2>&1 &
    local pid=$!
    echo "$pid" > "$TUNNEL_PID_FILE"

    # Wait briefly and check if process started
    sleep 2
    if kill -0 "$pid" 2>/dev/null; then
        log_info "Tunnel started (PID: $pid)"
        log_info "Forwarding ${TUNNEL_HASH}.containers.clanker.is -> localhost:${TUNNEL_LOCAL_PORT}"
        return 0
    else
        log_error "Tunnel failed to start. Check logs at ${TUNNEL_CONFIG_DIR}/rathole.log"
        rm -f "$TUNNEL_PID_FILE"
        return 1
    fi
}

# Stop tunnel connection
cmd_down() {
    if ! is_running; then
        log_warn "Tunnel not running"
        return 0
    fi

    local pid=$(cat "$TUNNEL_PID_FILE")
    log_info "Stopping tunnel (PID: $pid)..."

    kill "$pid" 2>/dev/null || true
    rm -f "$TUNNEL_PID_FILE"

    log_info "Tunnel stopped"
}

# Show tunnel status
cmd_status() {
    echo "=== Tunnel Status ==="
    echo ""

    if [ -z "$TUNNEL_HASH" ]; then
        echo "Hash:     (not configured)"
    else
        echo "Hash:     $TUNNEL_HASH"
        echo "URL:      https://${TUNNEL_HASH}.containers.clanker.is"
    fi

    echo "Server:   ${TUNNEL_SERVER_URL:-"(not configured)"}"
    echo "Local:    localhost:${TUNNEL_LOCAL_PORT}"
    echo ""

    if is_running; then
        local pid=$(cat "$TUNNEL_PID_FILE")
        echo -e "Status:   ${GREEN}CONNECTED${NC} (PID: $pid)"
    else
        echo -e "Status:   ${RED}DISCONNECTED${NC}"
    fi
}

# Check if tunnel is running
is_running() {
    if [ -f "$TUNNEL_PID_FILE" ]; then
        local pid=$(cat "$TUNNEL_PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        # Stale PID file, clean up
        rm -f "$TUNNEL_PID_FILE"
    fi
    return 1
}

# Show logs
cmd_logs() {
    local log_file="${TUNNEL_CONFIG_DIR}/rathole.log"
    if [ -f "$log_file" ]; then
        tail -f "$log_file"
    else
        log_error "No log file found at $log_file"
        return 1
    fi
}

# Show usage
cmd_help() {
    cat << EOF
cast-tunnel - Manage HTTP tunnel for CAST agent containers

Usage: cast-tunnel <command>

Commands:
  up      Register with tunnel server and connect
  down    Disconnect from tunnel server
  status  Show tunnel status and URL
  logs    Tail tunnel logs

Environment Variables:
  TUNNEL_SERVER_URL   Tunnel server URL (e.g., https://tunnel.clanker.is)
  TUNNEL_HASH         Unique hash for this container's hostname
  CAST_AUTH_TOKEN     Container authentication token
  TUNNEL_LOCAL_PORT   Local port to expose (default: 8080)

Flow:
  1. Calls POST /clients/register with TUNNEL_HASH and CAST_AUTH_TOKEN
  2. Receives serviceToken and controlPort from server
  3. Connects rathole client to server:controlPort

Example:
  export TUNNEL_SERVER_URL="https://tunnel.clanker.is"
  export TUNNEL_HASH="abc123def456..."
  export CAST_AUTH_TOKEN="container-auth-token..."
  cast-tunnel up

  # Your service is now available at:
  # https://abc123def456....containers.clanker.is

EOF
}

# Main entry point
case "${1:-}" in
    up)
        cmd_up
        ;;
    down)
        cmd_down
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        if [ -n "${1:-}" ]; then
            log_error "Unknown command: $1"
            echo ""
        fi
        cmd_help
        exit 1
        ;;
esac
