  "description": "Local agent server for running CAST agents on your machine",
  "type": "module",
  "main": "dist/src/local-agent.js",
  "bin": {
    "local-agent": "dist/src/local-agent.js",
    "local-agent-server": "dist/src/local-agent-server.js",
    "connect-local-agent": "dist/src/connect-local-agent.js"
  },
  "scripts": {
