# Cast Frontend Environment Variables
# Copy this file to .env.local for local development

# Backend API URL (optional - defaults to http://localhost:3234 in dev mode)
# VITE_API_URL=http://localhost:3234

# WebSocket URL (optional - defaults based on API_URL)
# VITE_WS_URL=ws://localhost:3234

# Auth mode: 'dev' or 'workos'
# - dev: Shows LoginPage with space picker (default for local development)
# - workos: Redirects to /auth/login for WorkOS OAuth flow (production)
# VITE_AUTH_MODE=dev
