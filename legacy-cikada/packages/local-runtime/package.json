{
  "name": "@cikada/local-runtime",
  "version": "0.1.0",
  "description": "Local development runtime for Cicada agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@cikada/agent": "workspace:*",
    "@cikada/core": "workspace:*",
    "@cikada/reactive-agent": "workspace:*",
    "better-sqlite3": "^11.6.0",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
